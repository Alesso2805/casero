{
	admin off
	# Caddy's error entries carry the client IP, the URI and headers such as X-Tenant-Token.
	log default {
		exclude http.log.error
	}
}

{$CASERO_DOMAIN} {
	tls {$CASERO_TLS}
	encode zstd gzip

	request_body {
		max_size 5MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@noindex path /privacidad /privacidad/* /legal /legal/* /libro-de-reclamaciones /libro-de-reclamaciones/* /baja /api/*
	header @noindex X-Robots-Tag noindex

	@too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 5242880`

	route {
		respond @too_large 413
		handle /admin* {
			respond 404
		}
		handle /api/admin/* {
			respond 404
		}
		# Served by Caddy from the environment so the complaints book can show who to
		# write to even when the API is down.
		handle /api/public/business {
			header Content-Type "application/json; charset=utf-8"
			templates {
				mime application/json
			}
			respond `{"name":{{env "CASERO_BUSINESS_NAME" | toJson}},"ruc":{{env "CASERO_BUSINESS_RUC" | toJson}},"address":{{env "CASERO_BUSINESS_ADDRESS" | toJson}},"complaints_inbox":{{env "CASERO_COMPLAINTS_INBOX" | toJson}},"privacy_inbox":{{env "CASERO_PRIVACY_INBOX" | toJson}}}`
		}
		handle /api/* {
			reverse_proxy api:8000
		}
		handle /assets/* {
			root * /srv
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			root * /srv
			try_files {path} /index.html
			header Cache-Control "no-cache"
			header /manifest.webmanifest Content-Type application/manifest+json
			file_server
		}
	}
}

www.{$CASERO_DOMAIN} {
	tls {$CASERO_TLS}
	redir https://{$CASERO_DOMAIN}{uri} permanent
}
