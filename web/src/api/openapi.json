{
  "components": {
    "schemas": {
      "FileComplaintRequest": {
        "properties": {
          "address": {
            "anyOf": [
              {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "claimed_amount_cents": {
            "anyOf": [
              {
                "maximum": 1000000000000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claimed Amount Cents"
          },
          "detail": {
            "maxLength": 5000,
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          },
          "document_number": {
            "maxLength": 30,
            "minLength": 1,
            "title": "Document Number",
            "type": "string"
          },
          "document_type": {
            "enum": [
              "dni",
              "ce",
              "passport"
            ],
            "title": "Document Type",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "format": "email",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "guardian": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GuardianRequest"
              },
              {
                "type": "null"
              }
            ]
          },
          "item_description": {
            "anyOf": [
              {
                "maxLength": 5000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Description"
          },
          "item_kind": {
            "enum": [
              "product",
              "service"
            ],
            "title": "Item Kind",
            "type": "string"
          },
          "kind": {
            "enum": [
              "claim",
              "complaint"
            ],
            "title": "Kind",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 30,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "request": {
            "anyOf": [
              {
                "maxLength": 5000,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Request"
          },
          "response_channel": {
            "enum": [
              "email",
              "letter"
            ],
            "title": "Response Channel",
            "type": "string"
          }
        },
        "required": [
          "full_name",
          "document_type",
          "document_number",
          "item_kind",
          "kind",
          "detail",
          "response_channel"
        ],
        "title": "FileComplaintRequest",
        "type": "object"
      },
      "FiledComplaintResponse": {
        "properties": {
          "due_on": {
            "format": "date",
            "title": "Due On",
            "type": "string"
          },
          "filed_at": {
            "format": "date-time",
            "title": "Filed At",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "string"
          }
        },
        "required": [
          "number",
          "filed_at",
          "due_on"
        ],
        "title": "FiledComplaintResponse",
        "type": "object"
      },
      "GuardianRequest": {
        "properties": {
          "address": {
            "anyOf": [
              {
                "maxLength": 300,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "email": {
            "anyOf": [
              {
                "format": "email",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "full_name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Full Name",
            "type": "string"
          },
          "phone": {
            "anyOf": [
              {
                "maxLength": 30,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "required": [
          "full_name"
        ],
        "title": "GuardianRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JoinWaitlistRequest": {
        "properties": {
          "consent": {
            "const": true,
            "title": "Consent",
            "type": "boolean"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "source": {
            "default": "landing",
            "enum": [
              "landing",
              "calculator"
            ],
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "email",
          "consent"
        ],
        "title": "JoinWaitlistRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Casero API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Report that the API process is up.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/api/public/complaints": {
      "post": {
        "description": "File a claim or a complaint in the virtual Libro de Reclamaciones.",
        "operationId": "file_complaint_api_public_complaints_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileComplaintRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FiledComplaintResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many requests from this client"
          }
        },
        "summary": "File Complaint"
      }
    },
    "/api/public/email-events": {
      "post": {
        "description": "Receive SES bounces and complaints through an SNS subscription.",
        "operationId": "receive_email_event_api_public_email_events_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Not an SNS message"
          },
          "403": {
            "description": "Wrong topic or invalid signature"
          }
        },
        "summary": "Receive Email Event"
      }
    },
    "/api/public/unsubscribe": {
      "post": {
        "description": "Stop one kind of scheduled email: RFC 8058 one-click, also used by the /baja page.",
        "operationId": "unsubscribe_api_public_unsubscribe_post",
        "parameters": [
          {
            "in": "query",
            "name": "u",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "U",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "k",
            "required": true,
            "schema": {
              "enum": [
                "daily_digest",
                "tax_reminders"
              ],
              "title": "K",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "t",
            "required": true,
            "schema": {
              "maxLength": 64,
              "title": "T",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "403": {
            "description": "The link is not valid"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Unsubscribe"
      }
    },
    "/api/public/waitlist": {
      "post": {
        "description": "Add an email to the waitlist once the visitor has given consent.",
        "operationId": "join_waitlist_api_public_waitlist_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JoinWaitlistRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "description": "Too many requests from this client"
          }
        },
        "summary": "Join Waitlist"
      }
    }
  }
}
