            "type": "string"
          },
          "deletion_requested_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletion Requested At"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "ends_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ends At"
          },
          "founder": {
            "title": "Founder",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "plan_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Code"
          },
          "purged_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Purged At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "trial_ends_at": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trial Ends At"
          }
        },
        "required": [
          "id",
          "email",
          "display_name",
          "created_at",
          "email_verified",
          "deletion_requested_at",
          "purged_at",
          "status",
          "plan_code",
          "trial_ends_at",
          "ends_at",
          "founder"
        ],
        "title": "AccountResponse",
        "type": "object"
      },
      "ComplaintDeadlineResponse": {
        "properties": {
          "due_on": {
            "format": "date",
            "title": "Due On",
            "type": "string"
          },
          "filed_at": {
            "format": "date-time",
            "title": "Filed At",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "string"
          },
          "responded_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Responded At"
          },
          "response_channel": {
            "title": "Response Channel",
            "type": "string"
          },
          "state": {
            "enum": [
              "answered",
              "open",
              "overdue"
            ],
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "number",
          "kind",
          "filed_at",
          "due_on",
          "responded_at",
          "response_channel",
          "state"
        ],
        "title": "ComplaintDeadlineResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PaymentResponse": {
        "properties": {
          "amount_cents": {
            "title": "Amount Cents",
            "type": "integer"
          },
          "boleta_number": {
            "title": "Boleta Number",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "method": {
            "title": "Method",
            "type": "string"
          },
          "months": {
            "title": "Months",
            "type": "integer"
          },
          "paid_on": {
            "format": "date",
            "title": "Paid On",
            "type": "string"
          }
        },
        "required": [
          "id",
          "amount_cents",
          "paid_on",
          "method",
          "boleta_number",
          "months"
        ],
        "title": "PaymentResponse",
        "type": "object"
      },
      "RecordPaymentRequest": {
        "properties": {
          "amount_cents": {
            "exclusiveMinimum": 0.0,
            "maximum": 10000000.0,
            "title": "Amount Cents",
            "type": "integer"
          },
          "boleta_number": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Boleta Number",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "method": {
            "enum": [
              "yape",
              "transfer"
            ],
            "title": "Method",
            "type": "string"
          },
          "months": {
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Months",
            "type": "integer"
          },
          "paid_on": {
            "format": "date",
            "title": "Paid On",
            "type": "string"
          }
        },
        "required": [
          "id",
          "amount_cents",
          "paid_on",
          "method",
          "boleta_number",
          "months"
        ],
        "title": "RecordPaymentRequest",
        "type": "object"
      },
      "ScheduleEntryResponse": {
        "properties": {
          "due_on": {
            "format": "date",
            "title": "Due On",
            "type": "string"
          },
          "period": {
            "title": "Period",
            "type": "string"
          },
          "ruc_group": {
            "title": "Ruc Group",
            "type": "string"
          },
          "source_url": {
            "title": "Source Url",
            "type": "string"
          }
        },
        "required": [
          "period",
          "ruc_group",
          "due_on",
          "source_url"
        ],
        "title": "ScheduleEntryResponse",
        "type": "object"
      },
      "StaffLoginRequest": {
        "properties": {
          "code": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "code"
        ],
        "title": "StaffLoginRequest",
        "type": "object"
      },
      "StaffResponse": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "StaffResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Casero Admin API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/admin/accounts": {
      "get": {
        "description": "Accounts whose email contains the text, without distinguishing case.",
        "operationId": "search_api_admin_accounts_get",
        "parameters": [
          {
            "in": "query",
            "name": "email",
            "required": true,
            "schema": {
              "maxLength": 254,
              "minLength": 3,
              "title": "Email",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountResponse"
                  },
                  "title": "Response Search Api Admin Accounts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid staff session"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search"
      }
    },
    "/api/admin/accounts/{account_id}": {
      "get": {
        "description": "One account with its subscription and the payments recorded for it.",
        "operationId": "view_api_admin_accounts__account_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDetailResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid staff session"
          },
          "404": {
            "description": "No such account"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "View"
      }
    },
    "/api/admin/accounts/{account_id}/payments": {
      "post": {
        "description": "Record a payment and extend the subscription; sending it again changes nothing.",
        "operationId": "record_payment_api_admin_accounts__account_id__payments_post",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Account Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid staff session"
          },
          "404": {
            "description": "No such account"
          },
          "409": {
            "description": "`account_closing`, `no_subscription`, or an id already used"
          },
          "422": {
            "description": "`future_date`, or an invalid body"
          }
        },
        "summary": "Record Payment"
      }
    },
    "/api/admin/complaints": {
      "get": {
        "description": "Complaints and their deadlines, without the consumer's data.",
        "operationId": "complaints_api_admin_complaints_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ComplaintDeadlineResponse"
                  },
                  "title": "Response Complaints Api Admin Complaints Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid staff session"
          }
        },
        "summary": "Complaints"
      }
    },
    "/api/admin/csrf": {
      "get": {
        "description": "Set the CSRF cookie that every unsafe request, login included, must echo.",
        "operationId": "issue_csrf_api_admin_csrf_get",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Issue Csrf"
      }
    },
    "/api/admin/health": {
      "get": {
        "description": "Report that the panel's listener is up and its role reaches the database.",
        "operationId": "health_api_admin_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "description": "`database_unavailable`"
          }
        },
        "summary": "Health"
      }
    },
    "/api/admin/me": {
      "get": {
        "description": "Who is signed in to the panel.",
        "operationId": "me_api_admin_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid staff session"
          }
        },
        "summary": "Me"
      }
    },
    "/api/admin/session": {
      "delete": {
        "description": "End this staff session.",
        "operationId": "log_out_api_admin_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Log Out"
      },
      "post": {
        "description": "Start a staff session, closing any earlier one.",
        "operationId": "log_in_api_admin_session_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StaffLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "description": "Wrong email, password or code"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Log In"
      }
    },
    "/api/admin/sunat-schedule": {
      "get": {
        "description": "The SUNAT schedule as loaded from the yearly files; the panel can't change it.",
        "operationId": "schedule_api_admin_sunat_schedule_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ScheduleEntryResponse"
                  },
                  "title": "Response Schedule Api Admin Sunat Schedule Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "No valid staff session"
          }
        },
        "summary": "Schedule"
      }
    }
  }
}
